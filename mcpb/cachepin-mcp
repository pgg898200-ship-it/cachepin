#!/bin/sh
set -eu
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
case "$OS" in
  darwin) OS="darwin" ;;
  linux)  OS="linux" ;;
  *) echo "cachepin-mcp: unsupported OS '$OS'" >&2; exit 1 ;;
esac
case "$ARCH" in
  x86_64|amd64)  ARCH="x86_64" ;;
  arm64|aarch64) ARCH="aarch64" ;;
  *) echo "cachepin-mcp: unsupported arch '$ARCH'" >&2; exit 1 ;;
esac
BIN="${DIR}/cachepin-${OS}-${ARCH}"
if [ ! -x "$BIN" ]; then
  echo "cachepin-mcp: missing binary $BIN" >&2
  exit 1
fi
exec "$BIN" mcp "$@"
